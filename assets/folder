:root{
  --navy-950:#081228;
  --navy-900:#0d1c3f;
  --navy-800:#16233F;
  --gold-500:#D4A24C;
  --gold-300:#F3CE86;
  --gold-glow: rgba(212,162,76,0.35);
  --blue-400:#4E8FF0;
  --ink-100:#EAF0FC;
  --ink-300:#C4D0E8;
  --ink-400:#93A3C4;
  --danger:#F0665E;
  --success:#5FD3A0;
  --radius:16px;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{
  background: radial-gradient(1200px 600px at 15% -10%, rgba(78,143,240,0.15), transparent 60%),
              linear-gradient(180deg, var(--navy-950), var(--navy-900) 45%, var(--navy-950));
  color:var(--ink-100);
  font-family:'Inter', sans-serif;
  min-height:100vh;
  display:flex; flex-direction:column; align-items:center;
  padding:32px 20px 60px;
}
h1,h2,h3,.display{ font-family:'Poppins', sans-serif; }
a{ color:var(--gold-300); }
.shell{ width:100%; max-width:480px; }
.shell.wide{ max-width:760px; }
.brand{ display:flex; align-items:center; gap:12px; justify-content:center; margin-bottom:28px; }
.brand img{ width:44px; height:44px; border-radius:50%; }
.brand b{ font-family:'Poppins',sans-serif; font-weight:800; font-size:16px; display:block; }
.brand em{ font-style:normal; color:var(--gold-300); font-size:11px; font-weight:600; letter-spacing:1.5px; text-transform:uppercase; }

.card{
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.09);
  border-radius:20px;
  padding:32px;
}
.card h2{ font-size:22px; font-weight:800; color:#fff; }
.card p.sub{ color:var(--ink-400); font-size:14px; margin-top:8px; margin-bottom:24px; }

label{ display:block; font-size:13px; font-weight:600; color:var(--ink-300); margin:16px 0 6px; }
label:first-of-type{ margin-top:0; }
input[type=text], input[type=email], input[type=tel], input[type=password], input[type=file]{
  width:100%; padding:12px 14px; border-radius:10px;
  border:1px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.04);
  color:#fff; font-size:14.5px; font-family:'Inter',sans-serif;
}
input:focus{ outline:none; border-color:var(--gold-500); box-shadow:0 0 0 3px rgba(212,162,76,0.15); }
input[type=file]{ padding:10px; font-size:13px; color:var(--ink-300); }
.hint{ font-size:12px; color:var(--ink-400); margin-top:5px; }
.consent-row{ display:flex; align-items:flex-start; gap:10px; margin-top:20px; }
.consent-row input{ width:auto; margin-top:3px; }
.consent-row label{ margin:0; font-size:13px; font-weight:400; color:var(--ink-300); }

.btn{
  width:100%; padding:14px; border-radius:12px; font-weight:700; font-size:15px;
  border:none; cursor:pointer; margin-top:24px;
  background:linear-gradient(135deg, var(--gold-300), var(--gold-500));
  color:var(--navy-950); transition:opacity .2s ease;
}
.btn:hover{ opacity:0.92; }
.btn:disabled{ opacity:0.5; cursor:not-allowed; }
.btn.secondary{
  background:transparent; border:1px solid rgba(255,255,255,0.2); color:var(--ink-100);
}
.footlink{ text-align:center; margin-top:20px; font-size:13.5px; color:var(--ink-400); }

.msg{ padding:12px 14px; border-radius:10px; font-size:13.5px; margin-top:18px; display:none; }
.msg.show{ display:block; }
.msg.error{ background:rgba(240,102,94,0.1); border:1px solid rgba(240,102,94,0.35); color:#FFC5C1; }
.msg.success{ background:rgba(95,211,160,0.1); border:1px solid rgba(95,211,160,0.35); color:#B7F0D8; }

.linkbox{
  display:flex; gap:8px; margin-top:10px;
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.12);
  border-radius:10px; padding:10px 12px; align-items:center;
}
.linkbox span{ flex:1; font-size:13px; color:var(--ink-300); word-break:break-all; }
.linkbox button{
  flex:none; background:var(--gold-500); color:var(--navy-950); border:none;
  border-radius:8px; padding:7px 12px; font-size:12.5px; font-weight:700; cursor:pointer;
}

table{ width:100%; border-collapse:collapse; margin-top:18px; font-size:13.5px; }
th{ text-align:left; color:var(--ink-400); font-weight:600; padding:10px 8px; border-bottom:1px solid rgba(255,255,255,0.12); font-size:12px; text-transform:uppercase; letter-spacing:0.4px; }
td{ padding:12px 8px; border-bottom:1px solid rgba(255,255,255,0.06); color:var(--ink-100); }
.badge{ display:inline-block; padding:3px 10px; border-radius:999px; font-size:11.5px; font-weight:700; }
.badge.a{ background:rgba(95,211,160,0.15); color:var(--success); }
.badge.b{ background:rgba(78,143,240,0.15); color:var(--blue-400); }
.badge.c{ background:rgba(212,162,76,0.15); color:var(--gold-300); }
.badge.fallback{ background:rgba(240,102,94,0.15); color:var(--danger); }

.topbar{ width:100%; max-width:760px; display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
.topbar .who{ font-size:13.5px; color:var(--ink-300); }
.topbar .who b{ color:#fff; }
.logout{ font-size:13px; color:var(--ink-400); border:1px solid rgba(255,255,255,0.15); padding:7px 14px; border-radius:999px; cursor:pointer; background:none; }
.logout:hover{ color:var(--ink-100); border-color:var(--gold-500); }

.empty{ text-align:center; padding:40px 10px; color:var(--ink-400); font-size:14px; }

pre.output{
  background:var(--navy-950); border:1px solid rgba(255,255,255,0.12); border-radius:10px;
  padding:14px; font-size:12.5px; color:var(--ink-300); overflow-x:auto; margin-top:14px;
  white-space:pre-wrap; word-break:break-word; max-height:320px; overflow-y:auto;
}
.spinner{ display:inline-block; width:14px; height:14px; border:2px solid rgba(0,0,0,0.2); border-top-color:var(--navy-950); border-radius:50%; animation:spin .7s linear infinite; vertical-align:-2px; margin-right:8px; }
@keyframes spin{ to{ transform:rotate(360deg); } }


